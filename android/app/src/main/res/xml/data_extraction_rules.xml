<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: Keystore keys cannot be restored on another device, so a restored (sealed) token would be
     unusable, and the pairing must be redone anyway (docs/android.md 4.1). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
