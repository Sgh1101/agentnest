<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- docs/android.md 6. No CAMERA: the QR scan runs inside Google Play services (code scanner). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Precondition of the connectedDevice foreground service type (normal permission). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- targetSdk 37 only: <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" /> -->

    <application
        android:name=".AgentNestApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgentNest"
        android:usesCleartextTraffic="false">

        <!-- Pre-downloads the code scanner module at install time (same value the Google sample declares). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- FragmentActivity subclass (BiometricPrompt needs one). singleTask: notification deep links reuse the instance.
             configChanges: Compose handles rotation/dark mode in place, so a running pairing is not torn down. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- agentnest://approval/{request_id}: only opens the detail screen, never decides anything. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="approval"
                    android:scheme="agentnest" />
            </intent-filter>
        </activity>

        <!-- Owns the socket. dataSync is forbidden (Android 15 time limits); connectedDevice has none. -->
        <service
            android:name=".service.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Optional auto-connect after boot (off by default, user setting). -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
