{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentnest.example/protocol/schema/s2c/bye.schema.json",
  "title": "bye payload",
  "description": "protocol.md 4.14",
  "type": "object",
  "properties": {
    "reason": {
      "enum": [
        "device_revoked",
        "shutdown",
        "restart",
        "superseded_connection",
        "unpaired"
      ]
    },
    "reconnect": {
      "type": "boolean"
    },
    "message_ko": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reason",
    "reconnect"
  ]
}
