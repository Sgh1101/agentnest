{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentnest.example/protocol/schema/s2c/adapter_status.schema.json",
  "title": "AdapterStatus",
  "description": "protocol.md 4.13",
  "type": "object",
  "properties": {
