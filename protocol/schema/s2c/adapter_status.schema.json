      "$ref": "../model/common.schema.json#/$defs/AgentKind"
    },
    "status": {
      "$ref": "../model/common.schema.json#/$defs/AdapterStatusKind"
    },
    "mode": {
      "$ref": "../model/common.schema.json#/$defs/AdapterMode"
    },
    "detail": {
