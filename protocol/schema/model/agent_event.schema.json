                  "update",
                  "delete",
                  "edit"
                ]
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "command_started"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "command"
          },
          "detail": {
            "required": [
              "command",
              "command_class",
