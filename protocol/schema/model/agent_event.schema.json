          "detail": {
            "required": [
              "tool_name",
              "error",
              "is_interrupt"
            ],
            "properties": {
              "error": {
                "type": "string",
                "maxLength": 2048
              },
              "is_interrupt": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "file_read"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "file"
          },
          "detail": {
            "required": [
              "file_path"
