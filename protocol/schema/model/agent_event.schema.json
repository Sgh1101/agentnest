              "run_in_background"
            ],
            "properties": {
              "command": {
                "type": "string",
                "maxLength": 2000
              },
              "command_class": {
                "enum": [
                  "test",
                  "build",
                  "vcs",
                  "package",
                  "fs",
                  "network",
                  "shell"
                ]
              },
              "run_in_background": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "command_completed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "command"
          },
          "detail": {
            "required": [
              "command",
              "command_class"
            ],
            "properties": {
              "command": {
                "type": "string",
                "maxLength": 2000
              },
              "command_class": {
                "enum": [
                  "test",
                  "build",
                  "vcs",
                  "package",
                  "fs",
                  "network",
                  "shell"
                ]
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "command_failed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "error"
          },
          "detail": {
            "required": [
              "command",
              "error"
            ],
            "properties": {
              "command": {
                "type": "string",
                "maxLength": 2000
              },
              "error": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "test_run"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "command"
          },
          "detail": {
            "required": [
              "command",
              "command_class",
              "runner"
            ],
            "properties": {
              "command": {
                "type": "string",
                "maxLength": 2000
              },
              "command_class": {
                "enum": [
                  "test",
                  "build",
                  "vcs",
                  "package",
                  "fs",
                  "network",
                  "shell"
                ]
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "test_passed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "command"
          },
          "detail": {
            "required": [
              "command",
              "command_class",
              "runner"
            ],
            "properties": {
              "command": {
                "type": "string",
                "maxLength": 2000
              },
              "command_class": {
                "enum": [
                  "test",
                  "build",
                  "vcs",
                  "package",
                  "fs",
                  "network",
                  "shell"
                ]
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "test_failed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "command"
          },
          "detail": {
            "required": [
              "command",
              "command_class",
              "runner"
            ],
            "properties": {
              "command": {
                "type": "string",
                "maxLength": 2000
              },
              "command_class": {
                "enum": [
                  "test",
                  "build",
                  "vcs",
                  "package",
                  "fs",
                  "network",
                  "shell"
                ]
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
