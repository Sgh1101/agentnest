        "properties": {
          "category": {
            "const": "lifecycle"
          },
          "detail": {
            "required": [
              "agent_id",
              "agent_type"
            ],
            "properties": {}
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
