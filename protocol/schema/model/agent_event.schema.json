          },
          "detail": {
            "required": [
              "agent_id",
              "agent_type"
            ],
            "properties": {}
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task_created"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "turn"
          },
          "detail": {
            "required": [
              "task_id",
              "task_subject"
            ],
            "properties": {}
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task_completed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "turn"
          },
          "detail": {
            "required": [
              "task_id",
              "task_subject"
            ],
            "properties": {}
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "approval_requested"
