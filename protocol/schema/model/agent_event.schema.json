{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentnest.example/protocol/schema/model/agent_event.schema.json",
  "title": "AgentEvent",
  "description": "protocol.md 5.1/5.2: normalised agent event. 'detail' required fields per kind follow the 5.2 table.",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "common.schema.json#/$defs/Uuid7"
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/Seq"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "agent_kind": {
      "$ref": "common.schema.json#/$defs/AgentKind"
    },
    "session_key": {
      "$ref": "common.schema.json#/$defs/SessionKey"
    },
    "actor": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agent_id": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "agent_type": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "is_subagent": {
              "type": "boolean"
            }
          },
          "title": "Actor"
        },
        {
          "type": "null"
        }
      ]
    },
    "project": {
      "anyOf": [
        {
          "$ref": "project_ref.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "session_started",
        "session_ended",
        "prompt_submitted",
        "turn_started",
        "turn_completed",
        "turn_failed",
        "turn_interrupted",
        "tool_started",
        "tool_completed",
        "tool_failed",
        "file_read",
        "file_modified",
        "command_started",
        "command_completed",
        "command_failed",
        "test_run",
        "test_passed",
        "test_failed",
        "subagent_started",
        "subagent_stopped",
        "task_created",
        "task_completed",
        "approval_requested",
        "approval_resolved",
        "permission_denied_auto",
        "notification",
        "idle",
        "context_compacted",
        "review_started",
        "review_completed",
        "review_finding",
        "token_usage_updated",
        "session_meta_updated",
        "agent_error",
        "adapter_status"
      ]
    },
    "category": {
      "enum": [
        "lifecycle",
        "turn",
        "tool",
        "file",
        "command",
        "approval",
        "error",
        "review",
        "notification",
        "usage",
        "adapter"
      ]
    },
    "severity": {
      "enum": [
        "debug",
        "info",
        "notice",
        "warning",
        "error"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1,
          "description": "Korean, <= 40 chars; built by the PC"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "headline"
      ],
      "title": "EventSummary"
    },
    "state_hint": {
      "anyOf": [
        {
          "$ref": "agent_state.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "type": "object",
      "description": "per-kind bounded object (8 KiB total, 2 KiB per string); never file bodies, full stdout or prompts"
    },
    "source": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "common.schema.json#/$defs/SourceChannel"
        },
        "native_event": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          },
          "maxProperties": 16
        }
      },
      "required": [
        "channel"
      ],
      "title": "EventSource"
    },
    "redacted": {
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "seq",
    "ts",
    "agent_kind",
    "session_key",
    "kind",
    "category",
    "severity",
    "summary",
    "detail",
    "source",
    "redacted"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session_started"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "lifecycle"
          },
          "detail": {
            "required": [
              "source_reason"
            ],
            "properties": {
              "source_reason": {
                "enum": [
                  "startup",
                  "resume",
                  "clear",
                  "compact",
                  "fork"
                ]
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session_ended"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "lifecycle"
          },
          "detail": {
            "required": [
              "reason"
            ],
            "properties": {}
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "prompt_submitted"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "turn"
          },
          "detail": {
            "required": [
              "prompt_preview",
              "prompt_len",
              "auto_turn_suspect"
            ],
            "properties": {
              "prompt_preview": {
                "type": "string",
                "maxLength": 200
              },
              "prompt_len": {
                "type": "integer",
                "minimum": 0
              },
              "auto_turn_suspect": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "turn_started"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "turn"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "turn_completed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "turn"
          },
          "detail": {
            "required": [
              "background_tasks",
              "session_crons"
            ],
            "properties": {
              "background_tasks": {
                "type": "integer",
                "minimum": 0
              },
              "session_crons": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "turn_failed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "error"
          },
          "detail": {
            "required": [
              "error_code"
            ],
            "properties": {}
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "turn_interrupted"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "turn"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool_started"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "tool"
          },
          "detail": {
            "required": [
              "tool_name",
              "tool_input_summary"
            ],
            "properties": {}
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool_completed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "tool"
          },
          "detail": {
            "required": [
              "tool_name"
            ],
            "properties": {}
          }
        },
        "required": [
          "detail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool_failed"
