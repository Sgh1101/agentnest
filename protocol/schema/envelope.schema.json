          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "unpair"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "c2s/unpair.schema.json"
          }
        }
      }
