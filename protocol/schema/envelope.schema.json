{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentnest.example/protocol/schema/envelope.schema.json",
  "title": "Envelope",
  "description": "protocol.md 2. Dispatches payload by type via if/then (unknown types pass untyped). Replayable types require seq.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "protocol major version; mismatch -> E_PROTO_VERSION + close 4010"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "message type; unknown types are silently ignored (forward compatible) so the schema only types the known ones"
    },
    "id": {
      "$ref": "model/common.schema.json#/$defs/Uuid7"
    },
    "ts": {
      "$ref": "model/common.schema.json#/$defs/Timestamp"
    },
    "seq": {
      "$ref": "model/common.schema.json#/$defs/Seq"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "pair"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "c2s/pair.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "c2s/hello.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ack"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "c2s/ack.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ping"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "c2s/ping.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "snapshot_request"
          }
        },
