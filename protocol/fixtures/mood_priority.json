{
  "_format": {
    "description": "Mood / focus resolution (docs/protocol.md 5.5, docs/character.md 2.1). Shared by Rust `state::focus` and Kotlin `MoodResolver`. Hysteresis (1.5 s minimum hold, upgrade-immediately) is NOT part of this file; it needs a clock and is tested separately.",
    "input": {
      "now": "RFC 3339",
      "link": "connected | offline | reconnecting | pc_unreachable | suspended (other LinkState values are not specified here)",
      "sessions[]": "session_key, agent_kind, state (AgentState, may be unknown), state_since, last_event_at, ended?"
    },
    "focus_priority": [
      "awaiting_approval",
      "awaiting_input",
      "error",
      "testing",
      "writing_code",
      "reviewing",
      "working",
      "completed",
      "idle",
      "disconnected"
    ],
    "rules": [
      "link != connected overrides everything: offline -> sleepy; reconnecting / pc_unreachable / suspended -> worried (no badge, focus not asserted).",
      "ended sessions are excluded; no live session -> blink_slow with focus null.",
      "focus = live session with the lowest rank in focus_priority; ties: newest last_event_at. Unknown states rank as 'working'.",
      "mood by focus state: awaiting_approval -> raise_hand badge '!' (count of awaiting_approval sessions); awaiting_input -> raise_hand badge '?' (count of awaiting_input sessions); error -> flustered; testing -> tools; writing_code -> typing (variant full); reviewing -> magnifier; working/unknown -> typing (variant weak); completed -> celebrate while now - state_since < 4 s else blink_slow; idle -> blink_slow; disconnected -> worried."
    ],
    "expect": {
      "mood": "KongiMood",
      "badge": "'!' | '?' | null",
      "badge_count": "number of sessions behind the badge",
      "variant": "typing only: full | weak",
      "focus_session_key": "null when no live session",
      "focus_state": "the focus session's raw state string"
    }
  },
  "cases": [
    {
