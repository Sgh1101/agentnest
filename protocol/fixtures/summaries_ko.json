{
  "_format": {
    "description": "Korean summary golden cases (docs/protocol.md 7). `cases` take a tool observation and expect {title (approval card), headline, detail?}; `event_cases` cover the non-tool rows. Lengths are counted in Unicode code points.",
    "rules": {
      "clip(s, n)": "s if len(s) <= n else s[:n-1] + '…'. Applied last: headline <= 40, detail <= 200 (first sentences: <= 120, description60: <= 60).",
      "{cmd60}": "strip leading 'cd X &&' segments, then a leading 'env' keyword and leading VAR=value assignments; mask with the redact patterns using '***' as the replacement (see redact_cases.json cmd_preview_cases); then clip to 60.",
      "{basename}": "last path segment after normalising '\\\\' to '/'.",
      "{rel_path}": "path relative to cwd (case-insensitive prefix, '/' separators); if outside cwd: last two segments.",
      "{cwd_short}": "basename of cwd",
      "{host}": "URL host only (never path, query or fragment)",
      "detail": "'{description}.' (a trailing '.' is not doubled) for test commands, '{description}' for the others; absent description => no detail except test commands ('{cwd_short} 에서 {cmd}') and Edit/Write rows that define their own detail.",
      "first sentence": "text up to and including the first '.', '!', '?' or U+3002 followed by whitespace/end, on the first line only.",
      "PermissionRequest headline": "'허락을 기다리고 있어요: ' + the tool headline, then clip to 40 (the tool headline is NOT pre-clipped).",
      "codex fileChange detail": "kind counts joined by ' · ' in the order update ('수정'), add ('새 파일'), delete ('삭제'), e.g. '수정 2개 · 새 파일 1개' (reading of the table cell '변경 종류별 개수')."
    },
    "unspecified_in_doc": [
      "StopFailure types other than rate_limit (12 types in total)",
      "WebSearch headline (no URL)",
      "fileChange with exactly one change"
    ]
  },
